# -----------------------------------------------------------------------------
# Secrets & environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Generated audio & assistant outputs
# -----------------------------------------------------------------------------
outputs/
*.wav
*.aiff
*.mp3
*.flac
*.ogg
# ...but keep tiny docs/readmes if they ever live under an ignored tree
!**/README.md

# -----------------------------------------------------------------------------
# Provided voice samples — legally licensed, private, NEVER committed
# -----------------------------------------------------------------------------
voice_samples/*
!voice_samples/README.md
!voice_samples/.gitkeep
!voice_samples/my_voice_sample.wav

# -----------------------------------------------------------------------------
# Knowledge base (Phase 2) — provided/copyrighted source material and the
# generated index are never committed. READMEs, eval banks, and the small
# original sample_*.md demo files ARE kept.
# -----------------------------------------------------------------------------
# Authored reference content (*.md) IS committed — it's Celeste's base
# knowledge, written in original wording. Provided/bulk source material in other
# formats (.txt, .pdf, .epub, transcripts) stays ignored so large or
# copyrighted files are never committed.
knowledge_base/sources/**
!knowledge_base/sources/**/
!knowledge_base/sources/**/*.md
!knowledge_base/sources/**/.gitkeep
knowledge_base/index/**
!knowledge_base/index/.gitkeep

# -----------------------------------------------------------------------------
# Local model files & TTS voices (large binaries, download locally)
# -----------------------------------------------------------------------------
voices/
models/
*.onnx
*.onnx.json
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.safetensors

# -----------------------------------------------------------------------------
# Caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.cache/
.DS_Store

# TTS / HF caches sometimes created in-repo
tts_home/
.tts/
