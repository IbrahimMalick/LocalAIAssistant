# -----------------------------------------------------------------------------
# Local AI Assistant — example environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your machine:
#     cp .env.example .env
#
# NEVER commit your real `.env`. It is git-ignored. This file contains NO
# secrets — everything here is a local endpoint or a non-sensitive default.
# -----------------------------------------------------------------------------

# ---- Assistant identity -----------------------------------------------------
# Active persona: Celeste Noir — The Manhattan Psychic (see src/assistant/prompts.py)
ASSISTANT_NAME=Celeste Noir

# ---- Local LLM (Ollama by default) ------------------------------------------
# Supported Phase 1 backend: ollama
LLM_BACKEND=ollama
# Ollama's default local endpoint. If you run the assistant inside Docker and
# Ollama on the Mac host, use http://host.docker.internal:11434 instead.
LLM_ENDPOINT=http://localhost:11434
# Mac-friendly default. Alternatives: qwen2.5:7b, mistral:7b, phi3:mini
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_REQUEST_TIMEOUT=120

# ---- Local TTS --------------------------------------------------------------
# Choose one: piper | coqui | say | none
#   piper -> fast local neural TTS (recommended default)
#   coqui -> Coqui XTTS v2, supports voice styling from a reference sample
#   say   -> macOS built-in `say` command (zero setup, good first test)
#   none  -> text-only, writes a transcript instead of audio (headless/CI)
TTS_BACKEND=piper

# Piper settings (used when TTS_BACKEND=piper)
PIPER_BINARY=piper
PIPER_MODEL=voices/en_US-lessac-medium.onnx

# Coqui XTTS settings (used when TTS_BACKEND=coqui)
COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
COQUI_LANGUAGE=en
# Optional: path to a LEGALLY PROVIDED voice sample for voice styling.
# Leave blank to use the model's default speaker.
# Example: voice_samples/client_sample_01.wav
COQUI_SPEAKER_WAV=

# ---- Knowledge base (Phase 2 — "Deep Memory") -------------------------------
# Embedding backend: ollama | hash
#   ollama -> local embedding model (recommended). Pull it once:
#             ollama pull nomic-embed-text
#   hash   -> dependency-free fallback for headless/CI and pipeline testing
#             (no model or network needed; keyword-overlap search only)
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text
# Vector dimension for the 'hash' fallback embedder only.
HASH_EMBEDDING_DIM=512
# Chunking (measured in words, ~= tokens)
KB_CHUNK_SIZE_WORDS=220
KB_CHUNK_OVERLAP_WORDS=40
# Retrieval
KB_TOP_K=5
# Minimum cosine similarity for a hit to be trusted; below this the assistant
# should say "I don't know" instead of answering from weak matches.
KB_MIN_SCORE=0.2

# ---- Paths ------------------------------------------------------------------
OUTPUTS_DIR=outputs
VOICE_SAMPLES_DIR=voice_samples
KB_DIR=knowledge_base
